# ═══════════════════════════════════════════════════════════
# Supabase — set these as real
# Environment Variables on Render. Never commit actual values.
# ═══════════════════════════════════════════════════════════

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AlexTrace needs no extra env vars — every check it runs (username
# enumeration, Gravatar, free HIBP breach list, EXIF metadata) is
# free and keyless.

# ═══════════════════════════════════════════════════════════
# AI labs (LLM chat challenges). Set as Environment Variables on Render.
# ═══════════════════════════════════════════════════════════

# Free API key from console.groq.com (no credit card needed)
GROQ_API_KEY=

# CTF lab flags are derived from FLAG_SECRET (falls back to SUPABASE_SERVICE_ROLE_KEY),
# see server/labs/flags.js. Optional; changing it changes every flag.
# FLAG_SECRET=

# Optional tuning. Defaults are fine to start with.
# AI_MODEL_EASY=openai/gpt-oss-20b
# AI_MODEL_FALLBACK=openai/gpt-oss-120b
# AI_EASY_MAX_MSGS=20
# AI_GLOBAL_PER_MIN=10
# AI_GLOBAL_PER_DAY=600

# AI hints: how many hints one player can ask per challenge (default 5)
# HINT_MAX_PER_CHALLENGE=5

# ═══════════════════════════════════════════════════════════
# Next.js frontend (see docs/MIGRATION.md)
# URL of the web/ Render service. Set it to serve the migrated pages
# (/blog, /tutorials, legal pages) from Next.js; leave it empty to keep
# the old SPA pages (instant rollback). NEXT_BLOG_URL = old name, still read.
# ═══════════════════════════════════════════════════════════
NEXT_APP_URL=
# Or run Next inside this service (Render setup, see docs/MIGRATION.md):
# NEXT_EMBEDDED=1
