# Public Supabase values (same ones as js/config.js; the anon key is public by design,
# RLS protects the data). Set these on the Render service for web/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin, used for canonical/OG URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://alexcyberx.com

# Dev only: where the Express app runs, so /css and /js resolve when opening Next directly.
EXPRESS_ORIGIN=http://localhost:3000
